# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# Example of extracting secrets from 1password (or another compatible pw manager)
# SECRETS=$(kamal secrets fetch --adapter 1password --account your-account --from Vault/Item KAMAL_REGISTRY_PASSWORD RAILS_MASTER_KEY)
# KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS})
# RAILS_MASTER_KEY=$(kamal secrets extract RAILS_MASTER_KEY ${SECRETS})

# Example of extracting secrets from Rails credentials
# KAMAL_REGISTRY_PASSWORD=$(rails credentials:fetch kamal.registry_password)

# Use a GITHUB_TOKEN if private repositories are needed for the image
# GITHUB_TOKEN=$(gh config get -h github.com oauth_token)

# Grab the registry password from ENV, then .env.kamal.local, then the current gh auth token.
# The GHCR token needs package push scope for deploys that build and push images.
KAMAL_REGISTRY_PASSWORD=$({ printenv KAMAL_REGISTRY_PASSWORD 2>/dev/null; sed -n 's/^KAMAL_REGISTRY_PASSWORD=//p' .env.kamal.local 2>/dev/null; gh auth token 2>/dev/null; } | awk 'length { print; exit }')

# Improve security by using a password manager. Never check config/master.key into git!
RAILS_MASTER_KEY=$(cat config/master.key 2>/dev/null || true)

# rccremote-docker app secrets:
# read from local .env.kamal.local for deploy convenience.
# Do not commit raw secrets.
SECRET_KEY_BASE=$(sed -n 's/^SECRET_KEY_BASE=//p' .env.kamal.local 2>/dev/null | head -n 1)
S3_ACCESS_KEY_ID=$(sed -n 's/^S3_ACCESS_KEY_ID=//p' .env.kamal.local 2>/dev/null | head -n 1)
S3_SECRET_ACCESS_KEY=$(sed -n 's/^S3_SECRET_ACCESS_KEY=//p' .env.kamal.local 2>/dev/null | head -n 1)
CLOUDFLARED_TOKEN=$(sed -n 's/^CLOUDFLARED_TOKEN=//p' .env.kamal.local 2>/dev/null | head -n 1)
ADMIN_CLOUDFLARED_TOKEN=$(sed -n 's/^ADMIN_CLOUDFLARED_TOKEN=//p' .env.kamal.local 2>/dev/null | head -n 1)
RCCREMOTE_CLOUDFLARED_TOKEN=$(sed -n 's/^RCCREMOTE_CLOUDFLARED_TOKEN=//p' .env.kamal.local 2>/dev/null | head -n 1)
