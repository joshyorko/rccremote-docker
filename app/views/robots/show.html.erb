<% content_for :title, "Workspace #{@robot.name} | Rails RCC Remote" %>
<% core_files_present = [ @robot.has_robot_yaml, @robot.has_conda_yaml ].count(true) %>
<% header_actions = capture do %>
  <div class="button-row">
    <%= link_to "Back to workspaces", robots_path, class: "button" %>
    <%= link_to "Edit core files", edit_files_robot_path(@robot.name), class: "button button-primary" %>
  </div>
<% end %>

<%= render "shared/page_header",
           kicker: "Workspace detail",
           title: @robot.name,
           subtitle: "Review the workspace root, core definitions, and file inventory before you change this execution surface.",
           status_text: @robot.valid_robot? ? "Ready" : "Needs attention",
           status_class: @robot.valid_robot? ? "ok" : "error",
           header_action: header_actions %>

<section class="stats-grid">
  <%= render "dashboard/stat_card",
             label: "Workspace root",
             value: @robot.path,
             hint: "Resolved from the configured robots path",
             state_class: "ok" %>
  <%= render "dashboard/stat_card",
             label: "Files",
             value: @robot.all_files.length,
             hint: "Current file inventory",
             state_class: @robot.all_files.empty? ? "warning" : "ok" %>
  <%= render "dashboard/stat_card",
             label: "Dependencies",
             value: @robot.dependencies_count,
             hint: "Declared in the robot definition",
             state_class: @robot.dependencies_count.positive? ? "ok" : "warning" %>
  <%= render "dashboard/stat_card",
             label: "Local .env",
             value: @robot.has_env_file ? "Present" : "Missing",
             hint: "Operator-specific runtime values",
             state_class: @robot.has_env_file ? "ok" : "warning" %>
  <%= render "dashboard/stat_card",
             label: "Core files",
             value: "#{core_files_present} of 2",
             hint: "robot.yaml and conda.yaml",
             state_class: core_files_present == 2 ? "ok" : "warning" %>
</section>

<section class="dashboard-grid dashboard-grid--main">
  <article class="panel dashboard-actions" id="workspace-actions">
    <div class="panel-header">
      <div>
        <h2 class="panel-title">Workspace actions</h2>
        <p class="panel-meta">Use uploads for support files. Use the editor when you need to change execution definitions.</p>
      </div>
    </div>

    <%= form_with url: upload_robot_path(@robot.name), method: :post, multipart: true, class: "action-tile action-tile--primary" do %>
      <strong>Upload files</strong>
      <span>Add one or more files to this workspace.</span>
      <div class="form-row form-row--spaced">
        <%= file_field_tag "files[]", multiple: true, class: "input" %>
        <%= submit_tag "Upload", class: "button button-primary" %>
      </div>
    <% end %>

    <div class="action-list action-list--compact">
      <%= link_to edit_files_robot_path(@robot.name), class: "action-tile" do %>
        <strong>Edit core files</strong>
        <span>Update <code>robot.yaml</code> and <code>conda.yaml</code> together.</span>
      <% end %>
    </div>
  </article>

  <article class="panel dashboard-telemetry">
    <div class="panel-header">
      <div>
        <h2 class="panel-title">Execution posture</h2>
        <p class="panel-meta">The paths and readiness signals that decide whether this workspace can run cleanly.</p>
      </div>
    </div>

    <div class="telemetry-grid">
      <div class="telemetry-item">
        <p class="telemetry-label">Path</p>
        <p class="telemetry-value"><code><%= @robot.path %></code></p>
      </div>
      <div class="telemetry-item">
        <p class="telemetry-label">robot.yaml</p>
        <p class="telemetry-value"><%= @robot.has_robot_yaml ? "Present" : "Missing" %></p>
      </div>
      <div class="telemetry-item">
        <p class="telemetry-label">conda.yaml</p>
        <p class="telemetry-value"><%= @robot.has_conda_yaml ? "Present" : "Missing" %></p>
      </div>
      <div class="telemetry-item">
        <p class="telemetry-label">.env</p>
        <p class="telemetry-value"><%= @robot.has_env_file ? "Present" : "Not detected" %></p>
      </div>
      <div class="telemetry-item">
        <p class="telemetry-label">Dependencies</p>
        <p class="telemetry-value"><%= @robot.dependencies_count %></p>
      </div>
      <div class="telemetry-item">
        <p class="telemetry-label">Validity</p>
        <p class="telemetry-value"><%= @robot.valid_robot? ? "Ready" : "Needs attention" %></p>
      </div>
    </div>
  </article>
</section>

<%= render "shared/page_section",
           section_attrs: { id: "core-definitions" },
           title: "Core file content",
           meta: "Read both configuration files before editing them in place.",
           header_action: link_to("Edit core files", edit_files_robot_path(@robot.name), class: "button button-primary") do %>
  <div class="path-grid">
    <article>
      <div class="path-label">robot.yaml</div>
      <pre class="terminal"><%= @robot.files.fetch("robot.yaml", "robot.yaml not found") %></pre>
    </article>

    <article>
      <div class="path-label">conda.yaml</div>
      <pre class="terminal"><%= @robot.files.fetch("conda.yaml", "conda.yaml not found") %></pre>
    </article>
  </div>
<% end %>

<%= render "shared/page_section",
           section_attrs: { id: "workspace-inventory" },
           title: "Workspace inventory",
           meta: "Everything currently stored under this workspace root." do %>
  <% if @robot.all_files.empty? %>
    <%= render "shared/empty_state", message: "No files found in this workspace yet." %>
  <% else %>
    <ul class="file-list">
      <% @robot.all_files.each do |file_path| %>
        <li><code><%= file_path %></code></li>
      <% end %>
    </ul>
  <% end %>
<% end %>
