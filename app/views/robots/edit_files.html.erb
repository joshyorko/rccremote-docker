<% content_for :title, "Edit Workspace Files #{@robot.name} | Rails RCC Remote" %>

<%= render "shared/page_header",
           kicker: "Workspace editor",
           title: "Edit core definitions: #{@robot.name}",
           subtitle: "Update the manifest and environment definition together so this workspace stays runnable.",
           header_action: link_to("Back", robot_path(@robot.name), class: "button") %>

<%= render "shared/page_section",
           section_class: "panel panel--wide" do %>
  <%= form_with url: update_files_robot_path(@robot.name), method: :patch do %>
    <div class="path-grid">
      <div>
        <label class="editor-label" for="robot_yaml">robot.yaml</label>
        <p class="panel-meta panel-meta--plain editor-panel__meta">Robot definition, tasks, and execution details.</p>
        <%= text_area_tag :robot_yaml, @robot.files.fetch("robot.yaml", ""), rows: 22, class: "code-input" %>
      </div>

      <div>
        <label class="editor-label" for="conda_yaml">conda.yaml</label>
        <p class="panel-meta panel-meta--plain editor-panel__meta">Package channels and dependencies for the workspace.</p>
        <%= text_area_tag :conda_yaml, @robot.files.fetch("conda.yaml", ""), rows: 22, class: "code-input" %>
      </div>
    </div>

    <div class="button-row editor-panel__actions">
      <%= submit_tag "Save Files", class: "button button-primary" %>
      <%= link_to "Cancel", robot_path(@robot.name), class: "button" %>
    </div>
  <% end %>
<% end %>
