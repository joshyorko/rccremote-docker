<% content_for :title, "Overview | Rails RCC Remote" %>
<% overview = dashboard_overview(@status) %>

<section class="panel dashboard-hero">
  <div class="dashboard-hero__copy">
    <p class="dashboard-kicker">Operator overview</p>
    <h1 class="dashboard-hero__title">Runtime overview</h1>
    <p class="dashboard-hero__subtitle">
      Keep workspace definitions, catalog snapshots, and import intake aligned with the live RCC runtime.
    </p>

    <div class="chip-row dashboard-hero__chips">
      <% dashboard_resource_chips(overview).each do |chip| %>
        <span class="chip <%= chip[:state_class] %>"><%= chip[:label] %></span>
      <% end %>
    </div>
  </div>

  <div class="dashboard-hero__meta">
    <span class="status-pill <%= overview[:rcc_running] ? "ok" : "error" %>">
      <span class="status-pill__dot" aria-hidden="true"></span>
      RCC <%= overview[:rcc_running] ? "online" : "offline" %>
    </span>
    <p class="dashboard-updated">Snapshot updated <%= overview[:timestamp] %></p>
  </div>
</section>

<section class="dashboard-grid dashboard-grid--metrics">
  <% dashboard_metrics(overview).each do |metric| %>
    <%= render "stat_card",
               label: metric[:label],
               value: metric[:value],
               hint: metric[:hint],
               state_class: metric[:state_class] %>
  <% end %>
</section>

<section class="dashboard-grid dashboard-grid--main">
  <article class="panel dashboard-actions">
    <div class="panel-header">
      <div>
        <h2 class="panel-title">Operator cadence</h2>
        <p class="panel-meta">The three surfaces that usually move together during an RCC change window.</p>
      </div>
    </div>
    <ol class="ops-flow">
      <% dashboard_flow_steps(overview).each_with_index do |step, index| %>
        <li class="ops-step <%= step[:state_class] %>">
          <div class="ops-step__index"><%= index + 1 %></div>
          <div class="ops-step__copy">
            <h3 class="ops-step__title"><%= step[:title] %></h3>
            <p class="ops-step__detail"><%= step[:detail] %></p>
          </div>
          <%= link_to step[:cta], step[:href], class: "ops-step__link" %>
        </li>
      <% end %>
    </ol>
  </article>

  <article class="panel dashboard-telemetry">
    <div class="panel-header">
      <div>
        <h2 class="panel-title">RCC telemetry</h2>
        <p class="panel-meta">Live runtime fields pulled from the control plane.</p>
      </div>
    </div>
    <div class="telemetry-grid">
      <% dashboard_telemetry_rows(overview).each do |row| %>
        <div class="telemetry-item">
          <p class="telemetry-label"><%= row[:label] %></p>
          <p class="telemetry-value"><%= row[:value] %></p>
        </div>
      <% end %>
    </div>

    <div class="telemetry-footnotes">
      <p><strong>RCC command:</strong> <code><%= overview[:rcc_command] %></code></p>
      <% if overview[:rcc_origin].present? %>
        <p><strong>RCC origin:</strong> <code><%= overview[:rcc_origin] %></code></p>
      <% end %>
      <p><strong>Robots path:</strong> <code><%= overview[:robots_path] %></code></p>
      <p><strong>Hololib ZIP path:</strong> <code><%= overview[:hololib_zip_path] %></code></p>
      <% if overview[:rcc_index_url].present? %>
        <p><strong>Release index:</strong> <code><%= overview[:rcc_index_url] %></code></p>
      <% end %>
    </div>
  </article>
</section>

<section class="panel dashboard-checklist">
  <div class="panel-header">
    <div>
      <h2 class="panel-title">Operational checklist</h2>
      <p class="panel-meta">Scan these before rebuilding catalogs or changing robot definitions.</p>
    </div>
  </div>
  <ul class="checklist">
    <% dashboard_checklist(overview).each do |item| %>
      <li class="<%= item[:state_class] %>">
        <span class="checklist__dot" aria-hidden="true"></span>
        <%= item[:message] %>
      </li>
    <% end %>
  </ul>
</section>
