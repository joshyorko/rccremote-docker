<% content_for :title, "Catalogs | Rails RCC Remote" %>

<% rebuild_action = capture do %>
  <%= form_with url: rebuild_catalogs_path,
                method: :post,
                class: "inline-form",
                data: {
                  catalog_rebuild_target: "form",
                  action: "submit->catalog-rebuild#start"
                } do %>
    <%= button_tag "Rebuild catalogs",
                   type: "submit",
                   class: "button button-primary",
                   data: { catalog_rebuild_target: "submit" } %>
  <% end %>
<% end %>

<%= render "shared/page_header",
           kicker: "Catalog workspace",
           title: "Catalog snapshots",
           subtitle: "Inspect the latest holotree snapshot, then rebuild it when workspace definitions change.",
           status_text: @catalog_error.present? ? "Needs attention" : "Ready",
           status_class: @catalog_error.present? ? "error" : "ok",
           header_action: rebuild_action,
           note: "Snapshot source #{@catalog_snapshot_source.to_s.upcase}#{@catalog_snapshot_at.present? ? " updated #{formatted_status_timestamp(@catalog_snapshot_at)}" : ""}",
           section_attrs: {
             id: "rebuild-catalogs",
             data: {
               controller: "catalog-rebuild",
               "catalog-rebuild-refresh-url-value": catalogs_path
             }
           } %>

<% if @catalog_error.present? %>
  <p class="empty error-text error-text--spaced"><%= @catalog_error %></p>
<% end %>

<div class="rebuild-progress" data-catalog-rebuild-target="progress" hidden>
  <div class="rebuild-progress__header">
    <p class="rebuild-progress__title">Catalog rebuild progress</p>
    <span class="rebuild-progress__percent" data-catalog-rebuild-target="percent">0%</span>
  </div>

  <div class="rebuild-progress__bar">
    <div class="rebuild-progress__fill" data-catalog-rebuild-target="bar"></div>
  </div>

  <p class="rebuild-progress__status" data-catalog-rebuild-target="status" aria-live="polite">Ready to rebuild.</p>
  <div class="rebuild-progress__log" data-catalog-rebuild-target="log" role="log" aria-live="polite"></div>
</div>

<section class="stats-grid">
  <%= render "dashboard/stat_card",
             label: "Snapshot rows",
             value: @catalogs.length,
             hint: @catalogs.empty? ? "No snapshot loaded yet" : "Ready for inspection",
             state_class: @catalogs.empty? ? "warning" : "ok" %>
  <%= render "dashboard/stat_card",
             label: "Snapshot source",
             value: @catalog_snapshot_source.to_s.upcase,
             hint: @catalog_snapshot_at.present? ? formatted_status_timestamp(@catalog_snapshot_at) : "No timestamp reported",
             state_class: @catalog_snapshot_at.present? ? "ok" : "warning" %>
  <%= render "dashboard/stat_card",
             label: "Rebuild status",
             value: @catalog_error.present? ? "Needs attention" : "Ready",
             hint: @catalog_error.present? ? "Resolve the error before relying on this snapshot" : "Rebuild from this page whenever robots change",
             state_class: @catalog_error.present? ? "error" : "ok" %>
</section>

<%= render "shared/page_section",
           title: "Latest holotree snapshot",
           meta: "Wide-format view of the current blueprint inventory." do %>
  <% if @catalogs.empty? %>
    <%= render "shared/empty_state", message: "No catalogs found. Create robots or upload ZIP files first." %>
  <% else %>
    <div class="table-wrap">
      <table class="table catalog-snapshot-table">
        <thead>
          <tr>
            <th>Blueprint</th>
            <th>Platform</th>
            <th>Size</th>
            <th>Files</th>
            <th>Dirs</th>
            <th>Relocations</th>
            <th>Age</th>
            <th>Idle</th>
            <th>Identity</th>
            <th>Holotree path</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <%= render partial: "catalog_row", collection: @catalogs, as: :catalog %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
