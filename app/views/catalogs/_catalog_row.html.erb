<tr>
  <td>
    <div class="catalog-row__headline">
      <code><%= display_value(catalog.blueprint) %></code>
      <span class="panel-meta panel-meta--plain">Snapshot <%= catalog_status_label(catalog) %></span>
    </div>
  </td>
  <td><%= display_value(catalog.platform) %></td>
  <td><%= catalog.bytes.present? ? human_bytes(catalog.bytes) : "n/a" %></td>
  <td><%= display_value(catalog.files) %></td>
  <td><%= display_value(catalog.directories) %></td>
  <td><%= display_value(catalog.relocations) %></td>
  <td><%= day_count_label(catalog.age_in_days) %></td>
  <td><%= day_count_label(catalog.days_since_last_use) %></td>
  <td>
    <% if catalog.identity_key.present? %>
      <code title="<%= catalog.identity_yaml %>"><%= catalog.identity_key.first(16) %>...</code>
    <% else %>
      n/a
    <% end %>
  </td>
  <td>
    <% if catalog.holotree.present? %>
      <code><%= catalog.holotree %></code>
    <% else %>
      n/a
    <% end %>
  </td>
  <td>
    <span class="chip <%= catalog_status_class(catalog) %>"><%= catalog_status_label(catalog) %></span>
  </td>
</tr>
