<article class="list-item">
  <div class="list-item__header">
    <div>
      <h3 class="list-item__title"><%= zip.name %></h3>
      <div class="chip-row">
        <span class="chip ok"><%= zip.size_mb %> MB</span>
        <span class="chip">Modified <%= zip.modified %></span>
      </div>
    </div>
    <%= button_to "Delete", hololib_zip_path(zip.name), method: :delete, class: "button button-danger", form: { class: "inline-form" }, data: { turbo_confirm: "Delete bundle #{zip.name}?" } %>
  </div>
</article>
