<section class="panel panel--narrow auth-panel">
  <div class="dashboard-kicker">Access</div>
  <h1 class="panel-title auth-panel__title">Sign in</h1>
  <p class="panel-meta auth-panel__intro">Open the RCC Remote control plane with your workspace credentials.</p>

  <%= form_with url: session_url, class: "auth-panel__form" do |form| %>
    <div class="auth-panel__fields">
      <div class="auth-panel__field">
        <%= form.label :email_address, "Email address", class: "editor-label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "name@example.com", value: params[:email_address], class: "input" %>
      </div>

      <div class="auth-panel__field">
        <%= form.label :password, "Password", class: "editor-label" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Enter your password", maxlength: 72, class: "input" %>
      </div>
    </div>

    <div class="button-row auth-panel__actions">
      <%= form.submit "Sign in", class: "button button-primary" %>
      <%= link_to "Forgot password?", new_password_path, class: "button" %>
    </div>
  <% end %>
</section>
